# Copy this file to .env and replace placeholders locally. Do not commit .env.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/culinary
SESSION_SECRET=replace-with-a-long-random-secret

# Required for secure six-digit signup and password-reset OTPs. Use a distinct
# random value of at least 32 characters; never reuse SESSION_SECRET.
OTP_SECRET=replace-with-a-separate-long-random-secret

# SMTP delivery for verification and recovery emails. Set SMTP_SECURE=true for
# implicit TLS (commonly port 465); use false for STARTTLS (commonly port 587).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="Culinary <no-reply@example.com>"
# Development/test only: set MAIL_MODE=preview to suppress SMTP delivery.
# Preview mode never logs OTPs and must not be used for a real verification flow.
# MAIL_MODE=preview

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# Keep this server-side. It is never sent to the browser.
GEMINI_API_KEY=your-gemini-api-key
# Optional: defaults to gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional milliseconds: defaults to 45000 and is capped at 60000.
GEMINI_TIMEOUT_MS=45000

# USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup/).
# Nutrition analysis runs on the backend; never expose this value to Vite/React.
USDA_API=your-usda-api-key
